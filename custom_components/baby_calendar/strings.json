  "services": {
    "log_diaper": {
      "name": "Log diaper change",
      "description": "Records a diaper change for a baby.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "content": {
          "name": "Content",
          "description": "Wet, dirty, or both."
        },
        "stool": {
          "name": "Stool type",
          "description": "Only for a dirty diaper."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Time",
          "description": "When it happened. Now if left empty."
        }
      }
    },
    "log_bottle": {
      "name": "Log bottle",
      "description": "Records a bottle for a baby.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "amount": {
          "name": "Amount",
          "description": "Millilitres, more than 0."
        },
        "content": {
          "name": "Content",
          "description": "Formula or breast milk."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Time",
          "description": "When it happened. Now if left empty."
        }
      }
    },
    "start_breastfeeding": {
      "name": "Start breastfeeding",
      "description": "Starts the breastfeeding timer. Fails if it is already running.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "side": {
          "name": "Side",
          "description": "Left or right. Optional."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Start",
          "description": "When it started. Now if left empty."
        }
      }
    },
    "stop_breastfeeding": {
      "name": "Stop breastfeeding",
      "description": "Stops the running breastfeeding timer.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "time": {
          "name": "End",
          "description": "When it ended. Now if left empty."
        }
      }
    },
    "log_breastfeeding": {
      "name": "Log breastfeeding",
      "description": "Records a finished breastfeeding entry of a given duration, without the timer.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "duration": {
          "name": "Duration",
          "description": "How long it lasted, more than 0."
        },
        "side": {
          "name": "Side",
          "description": "Left or right. Optional."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Start",
          "description": "When it started. If left empty, it ends now."
        }
      }
    },
    "start_sleep": {
      "name": "Start sleep",
      "description": "Starts the sleep timer. Fails if it is already running.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Start",
          "description": "When it started. Now if left empty."
        }
      }
    },
    "stop_sleep": {
      "name": "Stop sleep",
      "description": "Stops the running sleep timer.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "time": {
          "name": "End",
          "description": "When it ended. Now if left empty."
        }
      }
    },
    "log_sleep": {
      "name": "Log sleep",
      "description": "Records a finished sleep entry of a given duration, without the timer.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "duration": {
          "name": "Duration",
          "description": "How long it lasted, more than 0."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "time": {
          "name": "Start",
          "description": "When it started. If left empty, it ends now."
        }
      }
    },
    "update_event": {
      "name": "Correct entry",
      "description": "Changes the time, the notes or the tracker fields of an entry. Fields left out keep their value.",
      "fields": {
        "event_id": {
          "name": "Entry ID",
          "description": "Identifier of the entry."
        },
        "time": {
          "name": "Time",
          "description": "New time of the entry."
        },
        "end_time": {
          "name": "End",
          "description": "New end of a finished timed entry."
        },
        "notes": {
          "name": "Notes",
          "description": "New notes. Empty removes them."
        },
        "fields": {
          "name": "Fields",
          "description": "Tracker fields to change, such as content, stool or amount. A field set to null is cleared."
        }
      }
    },
    "delete_event": {
      "name": "Delete entry",
      "description": "Permanently deletes an entry.",
      "fields": {
        "event_id": {
          "name": "Entry ID",
          "description": "Identifier of the entry."
        }
      }
    },
    "list_events": {
      "name": "List entries",
      "description": "Returns a baby's entries between two times, oldest first.",
      "fields": {
        "device_id": {
          "name": "Baby",
          "description": "The baby."
        },
        "start": {
          "name": "Start",
          "description": "Start of the period, included."
        },
        "end": {
          "name": "End",
          "description": "End of the period, excluded."
        },
        "tracker": {
          "name": "Tracker",
          "description": "Only entries of this tracker."
        }
      }
    },
    "purge_history": {
      "name": "Delete stored history",
      "description": "Permanently deletes the stored history of a removed baby. A baby that is still configured is never affected.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Name of the removed baby."
        }
      }
    }
  },
